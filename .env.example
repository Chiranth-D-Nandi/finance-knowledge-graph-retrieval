# SEC EDGAR Requirements (Fair Access policy requires User-Agent: Name (email))
SEC_USER_AGENT_EMAIL=finnexus.research@financial-platform.internal

# Optional API Keys (degrades gracefully to public/free data & local models)
FRED_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Model Configuration
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct
SENTIMENT_MODEL=ProsusAI/finbert
USE_API_LLM_FALLBACK=true

# Storage & Runtime
DEVICE=cuda
DATA_DIR=data
LOG_LEVEL=INFO
SEED=42
